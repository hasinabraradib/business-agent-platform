# Copy to .env and adjust. Values here are local-development placeholders, not secrets.
# Never commit a real .env file.

# App
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=app
POSTGRES_PORT=5432

# Connection strings used by the backend when run outside Docker.
# Inside Docker Compose, DATABASE_URL and REDIS_URL are set by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5432/app_test
DB_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_PORT=8000
