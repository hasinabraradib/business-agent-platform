# Copy to .env and adjust. Values here are local-development placeholders, not secrets.
# Never commit a real .env file.

# App
APP_ENV=development
LOG_LEVEL=INFO

# Postgres owner role (superuser in local dev). Used by docker-compose.yml, migrations and the CLI.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-owner-local-only
POSTGRES_DB=app
POSTGRES_PORT=5432

# Password for the non-superuser application role "bap_app" that the API connects as.
APP_DB_PASSWORD=change-me-app-local-only

# Connection strings used by the backend when run outside Docker (tests, alembic, CLI).
# Inside Docker Compose these are built from the values above by docker-compose.yml.
# DATABASE_URL must connect as bap_app; OWNER_DATABASE_URL as the owner role.
DATABASE_URL=postgresql+asyncpg://bap_app:change-me-app-local-only@localhost:5432/app
OWNER_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner-local-only@localhost:5432/app
# Tests reuse both connection strings with this database name instead.
TEST_DATABASE_NAME=app_test
DB_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_PORT=8000

# Ingestion
# Where uploaded files are stored (inside Docker Compose this is the shared /data/uploads volume).
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=20
INGEST_JOB_TIMEOUT_SECONDS=600

# Embeddings: auto = gemini when GEMINI_API_KEY is set, otherwise fake (offline, not for production).
EMBEDDING_PROVIDER=auto
# Get a key at https://aistudio.google.com/apikey. Leave empty to use fake embeddings.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
