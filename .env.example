# Copy to .env and adjust. Values here are local-development placeholders, not secrets.
# Never commit a real .env file.

# App
APP_ENV=development
LOG_LEVEL=INFO

# Postgres owner role (superuser in local dev). Used by docker-compose.yml, migrations and the CLI.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-owner-local-only
POSTGRES_DB=app
POSTGRES_PORT=5432

# Password for the non-superuser application role "bap_app" that the API connects as.
APP_DB_PASSWORD=change-me-app-local-only

# Connection strings used by the backend when run outside Docker (tests, alembic, CLI).
# Inside Docker Compose these are built from the values above by docker-compose.yml.
# DATABASE_URL must connect as bap_app; OWNER_DATABASE_URL as the owner role.
DATABASE_URL=postgresql+asyncpg://bap_app:change-me-app-local-only@localhost:5432/app
OWNER_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner-local-only@localhost:5432/app
# Tests reuse both connection strings with this database name instead.
TEST_DATABASE_NAME=app_test
DB_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_PORT=8000

# Ingestion
# Where uploaded files are stored (inside Docker Compose this is the shared /data/uploads volume).
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=20
INGEST_JOB_TIMEOUT_SECONDS=600

# Embeddings: auto = gemini when GEMINI_API_KEY is set, otherwise fake (offline, not for production).
EMBEDDING_PROVIDER=auto
# Get a key at https://aistudio.google.com/apikey. Leave empty to use fake embeddings.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Retrieval
RRF_K=60
RETRIEVAL_CANDIDATES=30
RERANK_CANDIDATES=15
# Minimum top vector similarity for "has relevant context". Empty: the embedding provider's
# suggested value (0.65 for gemini-embedding-2, a starting point to tune against evals).
RELEVANCE_THRESHOLD=
QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_EF_SEARCH=100
# Reranker: auto = llm when GEMINI_API_KEY is set, otherwise noop. Or llm | fake | noop.
RERANKER=auto
RERANK_MODEL=gemini-3.5-flash-lite
RERANK_TIMEOUT_SECONDS=8

# Chat models, in failover order ("provider:model", primary first). Providers: gemini,
# openai_compat (needs OPENAI_COMPAT_*), fake. Entries without credentials are skipped; with no
# usable model the offline fake model is used. CHAT_PROVIDER=fake forces the offline model.
CHAT_PROVIDER=auto
CHAT_MODELS=gemini:gemini-3.6-flash,gemini:gemini-3.8-flash
# Switch to the next model if no token or tool call arrives within this many seconds.
CHAT_FAILOVER_SECONDS=3
CHAT_COOLDOWN_SECONDS=60
# Any OpenAI-compatible endpoint. When set (and not listed in CHAT_MODELS) it becomes the primary
# chat model, with CHAT_MODELS as fallbacks. Example, Groq:
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
#   OPENAI_COMPAT_REASONING_EFFORT=low
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_REASONING_EFFORT=
# The search tool's retrieval mode (hybrid_rerank turns the reranker on), depth and cap.
CHAT_RETRIEVAL_MODE=hybrid
CHAT_TOP_K=8
CHAT_MAX_SEARCHES=2
CHAT_HISTORY_MESSAGES=6
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=25
CHAT_TOTAL_TIMEOUT_SECONDS=90
# Public-endpoint protection
CHAT_RATE_PER_KEY_PER_MINUTE=60
CHAT_RATE_PER_VISITOR_PER_MINUTE=10
CHAT_DAILY_MESSAGE_CAP=2000

# Widget and demo pages
# Where the API finds the built widget.js (Docker Compose mounts web/widget/dist at /widget).
WIDGET_DIST_DIR=../web/widget/dist
DEMO_PORT=8080

# Human handoff and Telegram.
# Encrypts stored secrets (Telegram bot tokens). 32 random bytes, base64:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing it makes stored bot tokens unreadable (set the token again).
SECRETS_ENCRYPTION_KEY=
# Link to a conversation in staff alerts ({conversation_id} is filled in).
ADMIN_CONVERSATION_URL=http://localhost:8000/v1/conversations/{conversation_id}
# Email staff alerts (a tenant sets staff_alert_email in its settings). Empty host: off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Dashboard (web/dashboard). A long random value keeps sign-ins across restarts:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
DASHBOARD_SESSION_SECRET=
# Only for plain-http local use; leave unset behind https.
DASHBOARD_COOKIE_SECURE=false
