  {
   "id": "known-order-estimate",
   "tenant": "shop",
   "category": "known_failure",
   "description": "lookup_order returns status and ship date only; the reply must not add a delivery estimate.",
   "steps": [
    {
     "say": "Where is my order JL-10232? The last 4 digits of my phone are 6543"
    }
   ],
   "checks": [
    {
     "type": "tool_called",
     "tool": "lookup_order",
     "status": "ok"
    },
    {
     "type": "tool_args",
     "tool": "lookup_order",
     "field": "order_number",
     "pattern": "JL-10232"
    },
    {
     "type": "tool_args",
     "tool": "lookup_order",
     "field": "phone_last4",
     "pattern": "6543"
    },
    {
     "type": "grounded",
     "name": "every order fact from the tool result"
    },
    {
     "type": "reply_not_matches",
     "pattern": "arriv|should reach|be with you|\\bsoon\\b|tomorrow|within \\d",
     "name": "no invented delivery estimate"
    }
   ],
   "kind": "chat",
   "setup": null
  },
  {
   "id": "known-staff-detail",
   "tenant": "restaurant",
   "category": "known_failure",
   "description": "After a hand-back, the reply keeps the staff message's deadline and condition, cites it, and is not no_answer.",
   "steps": [
    {
     "say": "I want to talk to a real person"
    },
    {
     "staff": "Hi, this is Rumana. I have noted a table for 15 on Friday at 8 pm, but it is not confirmed yet: please call 01700-000000 before 6 pm on Thursday to confirm it."
    },
    {
     "hand_back": true
    },
    {
     "say": "So is my table for 15 confirmed now?"
    }
   ],
   "checks": [
    {
     "type": "reply_matches",
     "pattern": "6\\s*pm|6 ?ta|৬ ?টা",
     "name": "keeps the 6 pm deadline"
    },
    {
     "type": "reply_matches",
     "pattern": "thursday|brihoshpoti|বৃহস্পতি",
     "name": "keeps Thursday"
    },
    {
     "type": "reply_matches",
     "pattern": "not (yet )?confirmed|isn't confirmed|not been confirmed|unconfirmed|confirmed yet",
     "name": "still not confirmed"
    },
    {
     "type": "outcome",
     "not_in": [
      "no_answer",
      "error"
     ],
     "name": "not labelled no_answer"
    }
   ],
   "kind": "chat",
   "setup": null
  },
